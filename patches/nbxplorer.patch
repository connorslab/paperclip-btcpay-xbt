diff --git a/NBXplorer.Tests/XbtTests.cs b/NBXplorer.Tests/XbtTests.cs
new file mode 100644
index 0000000..1e89b78
--- /dev/null
+++ b/NBXplorer.Tests/XbtTests.cs
@@ -0,0 +1,68 @@
+using System.IO;
+using System.Linq;
+using NBitcoin;
+using NBitcoin.DataEncoders;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace NBXplorer.Tests;
+
+public class XbtTests
+{
+    [Fact]
+    public void FullBlockMatchesKnotsAndMerkleRoot()
+    {
+        var bytes = Encoders.Hex.DecodeData(File.ReadAllText("Data/xbt-block.hex").Trim());
+        var block = Block.Load(bytes, XbtNetwork.Instance.Mainnet);
+        Assert.Equal("0000000000000050c1e5f69672f459293be14f46e5a494e7a8c8541396f18eeb", block.GetHash().ToString());
+        Assert.True(block.CheckMerkleRoot());
+        Assert.Equal(bytes, block.ToBytes());
+    }
+    [Fact]
+    public void HeadersMatchKnotsAndRoundTrip()
+    {
+        var network = XbtNetwork.Instance.Mainnet;
+        Assert.Equal(Network.Main.Magic, network.Magic);
+        foreach (var vector in JArray.Parse(File.ReadAllText("Data/xbt-headers.json")))
+        {
+            var bytes = Encoders.Hex.DecodeData((string)vector["hex"]);
+            var header = network.Consensus.ConsensusFactory.CreateBlockHeader();
+            header.ReadWrite(bytes, network);
+            Assert.Equal((string)vector["hash"], header.GetHash().ToString());
+            Assert.Equal(bytes, header.ToBytes());
+        }
+    }
+
+    [Fact]
+    public void CanonicalHeaderV2VectorsMatchKnotsAndRoundTrip()
+    {
+        var network = XbtNetwork.Instance.Mainnet;
+        foreach (var vector in JArray.Parse(File.ReadAllText("Data/xbt-header-v2-vectors.json")))
+        {
+            var bytes = Encoders.Hex.DecodeData((string)vector["serialized"]);
+            var header = network.Consensus.ConsensusFactory.CreateBlockHeader();
+            header.ReadWrite(bytes, network);
+            Assert.Equal((string)vector["block_hash"], header.GetHash().ToString());
+            Assert.Equal(bytes, header.ToBytes());
+        }
+    }
+
+    [Fact]
+    public void MixedLegacyAndV2HeaderStreamConsumesExactLengths()
+    {
+        var network = XbtNetwork.Instance.Mainnet;
+        var vectors = JArray.Parse(File.ReadAllText("Data/xbt-headers.json"));
+        var legacy = Encoders.Hex.DecodeData((string)vectors[0]["hex"]);
+        var v2 = Encoders.Hex.DecodeData((string)vectors[1]["hex"]);
+        using var stream = new MemoryStream(legacy.Concat(v2).ToArray());
+        var bitcoinStream = new BitcoinStream(stream, false) { ConsensusFactory = network.Consensus.ConsensusFactory };
+        var first = network.Consensus.ConsensusFactory.CreateBlockHeader();
+        first.ReadWrite(bitcoinStream);
+        Assert.Equal(80, stream.Position);
+        var second = network.Consensus.ConsensusFactory.CreateBlockHeader();
+        second.ReadWrite(bitcoinStream);
+        Assert.Equal(244, stream.Position);
+        Assert.Equal((string)vectors[0]["hash"], first.GetHash().ToString());
+        Assert.Equal((string)vectors[1]["hash"], second.GetHash().ToString());
+    }
+}

diff --git a/NBXplorer.Client/XbtNetwork.cs b/NBXplorer.Client/XbtNetwork.cs
new file mode 100644
index 0000000..4500aa2
--- /dev/null
+++ b/NBXplorer.Client/XbtNetwork.cs
@@ -0,0 +1,108 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Text;
+using NBitcoin;
+using NBitcoin.Crypto;
+using Org.BouncyCastle.Crypto.Digests;
+
+namespace NBXplorer;
+
+/// <summary>XBT indexing/receiving only. Transaction signing is not implemented.</summary>
+public sealed class XbtNetwork : NetworkSetBase
+{
+    public static XbtNetwork Instance { get; } = new();
+    public override string CryptoCode => "XBT";
+    private static NetworkBuilder Create(Network source, string name)
+    {
+        var builder = new NetworkBuilder();
+        builder.CopyFrom(source);
+        var consensus = source.Consensus.Clone();
+        consensus.ConsensusFactory = XbtConsensusFactory.Instance;
+        builder.SetConsensus(consensus).SetName(name).SetNetworkSet(Instance).SetMagic(source.Magic);
+        return builder;
+    }
+    protected override NetworkBuilder CreateMainnet() => Create(Network.Main, "xbt-main");
+    protected override NetworkBuilder CreateTestnet() => Create(Network.TestNet, "xbt-test");
+    protected override NetworkBuilder CreateRegtest() => Create(Network.RegTest, "xbt-reg");
+}
+
+public sealed class XbtConsensusFactory : ConsensusFactory
+{
+    public static XbtConsensusFactory Instance { get; } = new();
+    public override BlockHeader CreateBlockHeader() => new XbtBlockHeader();
+    public override Block CreateBlock() => new XbtBlock();
+}
+
+public sealed class XbtBlock : Block
+{
+    public XbtBlock() : base(new XbtBlockHeader()) { }
+    public override ConsensusFactory GetConsensusFactory() => XbtConsensusFactory.Instance;
+}
+
+public sealed class XbtBlockHeader : BlockHeader
+{
+    // Header-v2's fixed-width extension, in wire order (Knots primitives/block.h).
+    private byte[] extension = new byte[84];
+    public bool IsV2 => ((uint)Version & 0x80000000U) != 0;
+    public override void ReadWrite(BitcoinStream stream)
+    {
+        var savedTime = BlockTime;
+        if (stream.Serializing && IsV2 && (extension[30] & 4) != 0)
+            BlockTime = DateTimeOffset.FromUnixTimeSeconds(unchecked((uint)savedTime.ToUnixTimeSeconds() - BitConverter.ToUInt32(extension,24)));
+        base.ReadWrite(stream);
+        if (IsV2) stream.ReadWrite(extension);
+        else extension = new byte[84];
+        if (stream.Serializing) BlockTime = savedTime;
+        else if (IsV2 && (extension[30] & 4) != 0)
+            BlockTime = DateTimeOffset.FromUnixTimeSeconds(unchecked((uint)BlockTime.ToUnixTimeSeconds() + BitConverter.ToUInt32(extension,24)));
+    }
+    protected override HashStreamBase CreateHashStream() => BufferedHashStream.CreateFrom(HashHeader,164);
+    private static byte[] Slice(byte[] b,int offset,int count) => b.Skip(offset).Take(count).ToArray();
+    private static byte[] Join(params byte[][] arrays) => arrays.SelectMany(x=>x).ToArray();
+    private static byte[] Tagged(string tag, params byte[][] data)
+    {
+        var t=Hashes.SHA256(Encoding.ASCII.GetBytes(tag));
+        return Hashes.SHA256(Join(new[]{t,t}.Concat(data).ToArray()));
+    }
+    private static byte[] Blake(byte[] data)
+    {
+        var digest=new Blake2bDigest(256);digest.BlockUpdate(data,0,data.Length);
+        var result=new byte[32];digest.DoFinal(result,0);return result;
+    }
+    private static byte[] HashHeader(byte[] buffer,int offset,int length)
+    {
+        var b=Slice(buffer,offset,length);
+        if ((BitConverter.ToUInt32(b,0)&0x80000000U)==0)
+        {
+            if(length!=80)throw new FormatException("Invalid legacy XBT header length");
+            return Hashes.DoubleSHA256(b).ToBytes();
+        }
+        if(length!=164)throw new FormatException("Invalid XBT v2 header length");
+        var key=Slice(b,112,16);
+        var keyHash=Tagged("Bitcoin block hash PoW XOR key",key);
+        var mask=new byte[32];
+        if(key.Any(x=>x!=0))
+        {
+            mask=Tagged("Bitcoin block hash PoW XOR mask",key);
+            var clear=b[111];Array.Clear(mask,0,clear/8);mask[clear/8]&=(byte)(255>>(clear%8));
+        }
+        var prev=Slice(b,4,32).Reverse().ToArray();
+        var hidden=Tagged("Bitcoin prevblock header, hashed",prev);
+        var count=new[]{b[108],b[109],(byte)0,(byte)0};
+        var h1=Tagged("Bitcoin block header 1",Slice(b,0,4),prev,Slice(b,128,4),Slice(b,36,32),
+            Slice(b,68,4),new byte[1],Slice(b,72,4),count,Slice(b,110,2),keyHash);
+        var h2=Tagged("Merge-mining hook",h1,new byte[32],Slice(b,132,32));
+        var first=Blake(Join(new byte[4],h2,Slice(b,88,16)));
+        var nonces=Join(Slice(b,76,8),Slice(b,104,4),Slice(b,84,4));
+        byte[] input;
+        switch(b[110]&3)
+        {
+            case 0:Array.Clear(hidden,0,6);input=Join(hidden,nonces,first);break;
+            case 1:input=Join(Slice(b,76,12),Slice(b,104,4),first,h2);break;
+            case 2:input=Join(new byte[48],h2,nonces,first);break;
+            default:input=Join(new byte[80],h2,nonces,first);break;
+        }
+        return Blake(input).Select((x,i)=>(byte)(x^mask[i])).Reverse().ToArray();
+    }
+}

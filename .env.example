# Copy to .env and fill in every required value. Never commit .env.
# Generate a new hex password: openssl rand -hex 32
POSTGRES_PASSWORD=
# Existing XBT Knots node, reachable from Docker. No SHA-256 BTC backend.
XBT_RPC_URL=http://host.docker.internal:9332/
XBT_RPC_USER=
XBT_RPC_PASSWORD=
XBT_P2P_ENDPOINT=host.docker.internal:9333
# Lightning backend: CLN (through the invoice-only gateway) or LND.
# CLN: keep COMPOSE_PROFILES=cln and fill in the CLN_* values below.
# LND: set COMPOSE_PROFILES= (empty) and XBT_LIGHTNING to the line printed by
#      scripts/lnd-connection.sh; the CLN_* values are then unused.
COMPOSE_PROFILES=cln
XBT_LIGHTNING=
# Absolute path to the existing XBT CLN Unix RPC socket (not its data directory).
CLN_SOCKET=
CLN_NODE_ID=
# Supplemental group with read/write access to the upstream RPC socket.
CLN_RPC_GID=1000
# Optional IPv4/IPv6 P2P endpoint when CLN has no announced addresses.
CLN_ADVERTISE_HOST=
CLN_ADVERTISE_PORT=9735
# Optional XBT payment icon for checkout and QR codes: a path under BTCPay's web
# root (mount the file, e.g. ./branding/icon.svg:/app/wwwroot/branding/icon.svg:ro)
# or an https URL. Leave empty for the default.
XBT_ICON=
# Optional label next to XBTSATS amounts, e.g. in Point of Sale (letters, digits and
# spaces, up to 24 characters). Leave empty for "XBT sats".
XBT_SATS_LABEL=
